# ==============================================================
# Google Gemini API & Platform Configuration Template
# For Local: Duplicate this file as '.env' and provide your Gemini API key.
# For Render: Add these keys under Environment Variables in the Render Dashboard.
# ==============================================================

# Google Gemini API Key - obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model (gemini-3.1-flash-lite, gemini-3.5-flash-lite, gemini-flash-latest)
GEMINI_MODEL=gemini-3.1-flash-lite

# Execution Engine Mode:
# 'auto'   -> Uses Google Gemini with automatic seamless fallback to local NLP engine
# 'gemini' -> Requires Google Gemini API connectivity
# 'local'  -> Runs 100% offline using the deterministic high-fidelity local engine
ENGINE_MODE=auto

# Flask Web Server Configuration (Render automatically sets PORT)
PORT=5050
HOST=0.0.0.0
DEBUG=False
